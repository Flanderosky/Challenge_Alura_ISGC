# Configuración del modelo de lenguaje
# Opciones: gemini, cohere, openai
LLM_PROVIDER=gemini

# Claves de API (usa solo la que corresponda a tu proveedor)
GOOGLE_API_KEY=tu_google_api_key
COHERE_API_KEY=tu_cohere_api_key
OPENAI_API_KEY=tu_openai_api_key

# Modelo a utilizar
GOOGLE_MODEL=gemini-3.1-flash-lite
COHERE_MODEL=command-r
OPENAI_MODEL=gpt-3.5-turbo

# Token para agregar o quitar documentos. Si se deja vacío, la escritura queda
# abierta, que es lo cómodo en local. En un servidor público, defínelo:
#   openssl rand -hex 24
ALURA_ADMIN_TOKEN=

# Puerto del host donde se publica la aplicación. El contenedor siempre
# escucha en el 8000; esto solo cambia por dónde se entra desde fuera.
HOST_PORT=8000

# Cuota de consultas al modelo, para que la demo pública no agote la cuota
# gratuita. 0 desactiva el límite. El token de administración se los salta.
ALURA_LIMITE_DIARIO_IP=5
ALURA_LIMITE_DIARIO_TOTAL=200

# Usuario con el que corre el contenedor. Debe coincidir con el dueño de la
# carpeta data/ del host, o subir documentos fallará con permiso denegado.
# Averigua los tuyos con:  id -u; id -g
APP_UID=1000
APP_GID=1000
